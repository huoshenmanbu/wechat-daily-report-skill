{
  "feishu_cli_webhook": {
    "command": ["feishu-cli"],
    "webhook_url_env": "FEISHU_WEBHOOK_URL",
    "webhook_secret_env": "FEISHU_WEBHOOK_SECRET",
    "message_format": "text",
    "args_template": [
      "webhook",
      "send",
      "--url",
      "__WEBHOOK__",
      "--msg-type",
      "__MSG_TYPE__",
      "--content",
      "__CONTENT__"
    ]
  },
  "feishu_cli_card": {
    "command": ["feishu-cli"]
  },
  "feishu_im_api": {
    "app_id_env": "FEISHU_APP_ID",
    "app_secret_env": "FEISHU_APP_SECRET"
  }
}
