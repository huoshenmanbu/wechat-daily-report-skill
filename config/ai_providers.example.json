{
  "cursor_cli": {
    "command": ["agent"],
    "trust_workspace": true,
    "hide_window": false,
    "force": false,
    "retry_on_empty_stdout": false,
    "cmdline_char_limit": 28000,
    "reuse_session": false,
    "session_state_path": "runtime/cursor_cli_session.json",
    "resume_style": "explicit_id",
    "on_resume_failure": "clear_and_retry_fresh"
  },
  "dashscope": {
    "api_key_env": "DASHSCOPE_API_KEY",
    "model": "qwen-plus",
    "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1"
  },
  "volc_ark": {
    "api_key_env": "ARK_API_KEY",
    "endpoint_id": "",
    "region": ""
  }
}
